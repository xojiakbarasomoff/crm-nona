# ---- Runtime mode: demo | staging | production (TZ §25.1) ----
# demo: provider adapters are mocks, UI shows a DEMO banner, nothing is sent to real customers.
# production refuses to start if any mock adapter is configured.
APP_MODE=demo
NODE_ENV=development
LOG_LEVEL=info

# ---- Database / Redis ----
DATABASE_URL=postgresql://crm:crm_local_only@127.0.0.1:55432/crm
TEST_DATABASE_URL=postgresql://crm:crm_local_only@127.0.0.1:55432/crm_test
REDIS_URL=redis://127.0.0.1:56379
TEST_REDIS_URL=redis://127.0.0.1:56379/15

# ---- Public URLs ----
API_PORT=4100
APP_PUBLIC_URL=http://localhost:3100
API_PUBLIC_URL=http://localhost:4100
# Used by Next.js server-side rewrites
API_INTERNAL_URL=http://127.0.0.1:4100

# ---- Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ----
SESSION_SECRET=change-me-local-session-secret-at-least-32-chars
# 32 bytes base64; encrypts integration credentials, MFA secrets and raw webhook payloads
ENCRYPTION_KEY=
COOKIE_SECURE=false

# ---- amoCRM REST OAuth (separate from Chats API) ----
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=
# Comma separated allowlist of account base domains, e.g. mycompany.amocrm.ru
AMO_ALLOWED_DOMAINS=
AMO_RATE_LIMIT_RPS=5

# ---- amoCRM Chats API channel (own auth, see docs/decisions/0002) ----
AMO_CHAT_CHANNEL_ID=
AMO_CHAT_SECRET=
AMO_CHAT_BOT_NAME=Instagram Direct
# native_connector | custom_channel
DIRECT_CHANNEL_MODE=custom_channel

# ---- Meta ----
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Graph API version is explicit configuration; confirm in G07 (docs/feasibility.md)
META_GRAPH_VERSION=
# instagram_login | facebook_login
META_DIRECT_LOGIN=instagram_login
META_STANDARD_WINDOW_HOURS=24
META_HUMAN_AGENT_WINDOW_HOURS=
META_HUMAN_AGENT_GRANTED=false

# ---- Object storage (private) ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=10485760

# ---- Worker ----
SCHEDULER_INTERVAL_MS=15000
OUTBOX_INTERVAL_MS=1000
RECONCILE_INTERVAL_MS=300000

# ---- Monitoring ----
METRICS_TOKEN=
