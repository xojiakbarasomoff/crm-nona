  bookingProvider        String?           @map("booking_provider")
  operationalStatus      OperationalStatus @default(scheduled) @map("operational_status")
  scheduleRevision       Int               @default(1) @map("schedule_revision")
  checkState             CheckState        @default(pending) @map("check_state")
  notificationState      NotificationState @default(not_required) @map("notification_state")
  lastCheckedAt          DateTime?         @map("last_checked_at") @db.Timestamptz(3)
  checkedById            String?           @map("checked_by_id") @db.Uuid
  nextReminderAt         DateTime?         @map("next_reminder_at") @db.Timestamptz(3)
  evidenceSource         String?           @map("evidence_source")
  ownerId                String?           @map("owner_id") @db.Uuid
