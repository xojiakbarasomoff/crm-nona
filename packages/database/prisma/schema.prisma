  destinationAirportName String?           @map("destination_airport_name")
  marketingCarrier       String            @map("marketing_carrier")
  operatingCarrier       String?           @map("operating_carrier")
  flightNumber           String            @map("flight_number")
  departureAtUtc         DateTime?         @map("departure_at_utc") @db.Timestamptz(3)
  departureTimezone      String            @map("departure_timezone")
  departureLocalOriginal String?           @map("departure_local_original")
